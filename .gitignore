# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- Build artefacts ------------------------------------------------------
build/
dist/
*.spec.bak

# The seeded design canvas is a ~2.4 MB generated bundle of minified vendor
# JS, rebuilt from design/*.dc.html whenever it is published. The sources are
# tracked; the bundle is not -- one `git add -A` would put it in history for
# good.
design/*.html
!design/*.dc.html

# --- App output -----------------------------------------------------------
out/
*.tmp

# --- Test / tooling -------------------------------------------------------
.pytest_cache/
.coverage

# --- Payroll data: NEVER commit ------------------------------------------
# Real salary figures and employee PII. Keep these locally as references,
# but they must not enter git history -- once committed they are effectively
# permanent, even if deleted in a later commit.
*.xlsx
*.xlsm
Pay Slip*.pdf
wireframe1.jpeg
samples/
